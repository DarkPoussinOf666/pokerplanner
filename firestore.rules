rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms collection: Managed by backend for room synchronization, listing and persistence
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
